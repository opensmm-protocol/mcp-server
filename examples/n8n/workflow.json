{
  "name": "OpenSMM — mock order: quote → order → replay → poll",
  "nodes": [
    {
      "parameters": {},
      "id": "c1f0a1d0-0001-4000-8000-000000000001",
      "name": "Run once",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-60, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-base-url",
              "name": "baseUrl",
              "value": "http://127.0.0.1:8080",
              "type": "string"
            },
            {
              "id": "cfg-quantity",
              "name": "quantity",
              "value": 100,
              "type": "number"
            },
            {
              "id": "cfg-link",
              "name": "link",
              "value": "https://t.me/opensmm_example",
              "type": "string"
            },
            {
              "id": "cfg-reference",
              "name": "clientReference",
              "value": "={{ 'n8n-demo-' + Date.now() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "c1f0a1d0-0002-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [160, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.baseUrl + '/v0/services' }}",
        "options": {}
      },
      "id": "c1f0a1d0-0003-4000-8000-000000000003",
      "name": "GET catalog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [380, 300]
    },
    {
      "parameters": {
        "jsCode": "const catalog = $input.first().json;\nconst service = catalog.services?.[0];\nif (!service) throw new Error('the node returned an empty catalog: no services to order');\nif (service.synthetic !== true) {\n  throw new Error('refusing to place a demo order: ' + service.serviceId + ' is not marked synthetic — mock catalog only');\n}\nconst config = $('Config').first().json;\nreturn [{ json: { ...config, serviceId: service.serviceId } }];\n"
      },
      "id": "c1f0a1d0-0004-4000-8000-000000000004",
      "name": "Guard: mock only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl + '/v0/quotes' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ serviceId: $json.serviceId, quantity: $json.quantity, link: $json.link }) }}",
        "options": {}
      },
      "id": "c1f0a1d0-0005-4000-8000-000000000005",
      "name": "Create quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [820, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl + '/v0/orders' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ quoteId: $('Create quote').first().json.quoteId, link: $('Config').first().json.link, clientReference: $('Config').first().json.clientReference }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c1f0a1d0-0006-4000-8000-000000000006",
      "name": "Create order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl + '/v0/orders' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ quoteId: $('Create quote').first().json.quoteId, link: $('Config').first().json.link, clientReference: $('Config').first().json.clientReference }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c1f0a1d0-0007-4000-8000-000000000007",
      "name": "Replay order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 300]
    },
    {
      "parameters": {
        "jsCode": "const order = $('Create order').first().json;\nconst replay = $('Replay order').first().json;\nif (!order.orderId || !replay.orderId) throw new Error('no orderId in the node response');\nif (order.orderId !== replay.orderId) throw new Error('two orderIds for one clientReference');\nreturn [{ json: { catalog: 'MOCK', orderId: order.orderId, clientReference: order.clientReference, paymentStatus: order.paymentStatus } }];\n"
      },
      "id": "c1f0a1d0-0008-4000-8000-000000000008",
      "name": "Verify idempotency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1480, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl + '/v0/orders/' + $('Create order').first().json.orderId }}",
        "options": {}
      },
      "id": "c1f0a1d0-0009-4000-8000-000000000009",
      "name": "Poll order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 300]
    }
  ],
  "connections": {
    "Run once": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "GET catalog", "type": "main", "index": 0 }]]
    },
    "GET catalog": {
      "main": [[{ "node": "Guard: mock only", "type": "main", "index": 0 }]]
    },
    "Guard: mock only": {
      "main": [[{ "node": "Create quote", "type": "main", "index": 0 }]]
    },
    "Create quote": {
      "main": [[{ "node": "Create order", "type": "main", "index": 0 }]]
    },
    "Create order": {
      "main": [[{ "node": "Replay order", "type": "main", "index": 0 }]]
    },
    "Replay order": {
      "main": [[{ "node": "Verify idempotency", "type": "main", "index": 0 }]]
    },
    "Verify idempotency": {
      "main": [[{ "node": "Poll order", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "opensmm-n8n-mock-order-v1",
  "meta": {},
  "tags": []
}
