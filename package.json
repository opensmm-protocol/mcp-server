{
  "name": "@opensmm/mcp-server",
  "version": "0.1.0",
  "description": "OpenSMM Protocol — open MCP server and REST gateway for ordering social media growth services (SMM) via AI agents. Provider-neutral, idempotent, x402/USDC-Base direct settlement.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "llm-tools",
    "agent-economy",
    "smm",
    "social-media-marketing",
    "social-media-api",
    "telegram-api",
    "instagram-api",
    "x402",
    "usdc",
    "base",
    "micropayments",
    "typescript"
  ],
  "homepage": "https://opensmm.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensmm-protocol/mcp-server.git"
  },
  "bugs": "https://github.com/opensmm-protocol/mcp-server/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "spec",
    "data",
    "docs",
    "llms.txt",
    "mcp.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "opensmm": "./bin/opensmm.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "rest": "node --env-file-if-exists=.env src/adapters/inbound/rest/server.ts",
    "mcp": "node --env-file-if-exists=.env src/adapters/inbound/mcp/server.ts",
    "mcp:http": "node --env-file-if-exists=.env src/adapters/inbound/mcp/http.ts",
    "gateway": "node --env-file-if-exists=.env src/adapters/inbound/gateway.ts",
    "x402:testnet": "node --env-file-if-exists=.env scripts/x402-testnet-run.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3",
    "viem": "^2.57.16"
  }
}
