# OpenSMM node configuration — copy to .env and uncomment what you need.
# Every value below is optional: without them the node boots on the built-in
# mock catalog with the mock payment rail. No keys, no external services.
# Table of the same variables: docs/DEPLOY.md («Environment»).

# Listen port for the combined node (REST /v0 and MCP /mcp). Default 8080.
#PORT=8080

# Path to the JSON state snapshot (orders, metrics, self-registered nodes).
# Unset = in-memory only, state is lost on restart. The file holds provider
# credentials and is written with mode 0600 — treat it as a secret.
#OPENSMM_STATE_FILE=/data/opensmm-state.json

# Autosave cadence of the state snapshot, milliseconds. Default 30000.
#OPENSMM_STATE_SAVE_MS=30000

# Live execution provider (reseller-style REST v1 API). Both or neither:
# without them the node serves the mock catalog and places no real orders.
#OPENSMM_REST_V1_BASE_URL=https://provider.example/api/v1
#OPENSMM_REST_V1_API_KEY=

# providerId override for the live provider. Default "rest-v1".
#OPENSMM_PROVIDER_ID=rest-v1

# Opt-in public displayName in list_providers (spec/v0 §9). Default: hidden.
#OPENSMM_PROVIDER_LISTED_NAME=

# Direct-settlement payTo address (USDC on Base) published in the payment
# requirements of this node's orders (spec/v0 §8).
#OPENSMM_PROVIDER_PAYOUT=0xYourUsdcBaseAddress

# Path to a curated public catalog JSON (README «Public MVP»). Replaces the
# dev seed / live sync as the served catalog and disables background sync.
#OPENSMM_CURATED_CATALOG=data/curated-services.json

# Background supervision: catalog sync and order polling. Default on for a
# live provider, off for the mock stack. 0 disables it.
#OPENSMM_SUPERVISOR=1
#OPENSMM_SYNC_INTERVAL_MS=300000
#OPENSMM_POLL_INTERVAL_MS=30000
#OPENSMM_RETENTION_CHECK_MS=604800000

# Dev-only SSRF escape hatch: allow private/loopback provider endpoints.
# Never set this on a public node.
#OPENSMM_ALLOW_PRIVATE_ENDPOINTS=1

# x402 payment rail. When the facilitator URL is set, real settlement
# replaces the dev-only mock rail; PAYTO_ADDRESS is then required.
#OPENSMM_STATE_FILE and X402_PAYTO_ADDRESS answer different questions:
# the former is gateway state, the latter is where money goes.
#X402_FACILITATOR_URL=https://x402.org/facilitator
#X402_PAYTO_ADDRESS=0xYourUsdcBaseAddress
#X402_FACILITATOR_API_KEY=
# CAIP-2 network id. Default eip155:84532 (Base Sepolia, testnet).
#X402_NETWORK=eip155:84532
# USDC contract override for networks outside the built-in table.
#X402_USDC_ADDRESS=
# EIP-712 domain override, paired with X402_USDC_ADDRESS. Both or neither.
#X402_EIP712_DOMAIN_NAME=
#X402_EIP712_DOMAIN_VERSION=
